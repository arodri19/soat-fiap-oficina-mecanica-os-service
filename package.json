{
  "name": "oficina-os-service",
  "version": "4.0.0",
  "description": "OS Service — abertura, status e histórico das ordens de serviço da oficina mecânica; orquestrador da saga de ordem de serviço (Fase 4).",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:bdd": "jest tests/bdd --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:ci": "jest --coverage --runInBand --ci"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "oficina",
    "microservice",
    "saga",
    "express",
    "prisma",
    "postgres",
    "sqs"
  ],
  "author": "Equipe Oficina",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@prisma/client": "^5.12.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "newrelic": "^14.3.9",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-cucumber": "^4.5.0",
    "nodemon": "^3.0.1",
    "prisma": "^5.12.0",
    "supertest": "^6.3.4"
  }
}
