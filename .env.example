DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oficina?schema=public
JWT_SECRET=sua_chave_jwt_aqui
PORT=4000

# ── Mensageria (Amazon SQS) ───────────────────────────────────────────────────
# Prefixo das filas: <prefixo>-os-saga-replies | -billing-commands | -execution-commands
QUEUE_PREFIX=oficina-mecanica-dev
AWS_REGION=us-east-1
# LocalStack (docker compose): http://localhost:4566 — vazio = AWS real
SQS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# false = sobe só a API, sem relay do outbox/consumidor de respostas
MESSAGING_ENABLED=true

# Timeouts por etapa da saga (minutos) — etapa parada além disso é compensada
SAGA_TIMEOUT_BUDGET_MINUTES=10
SAGA_TIMEOUT_APPROVAL_MINUTES=4320
SAGA_TIMEOUT_PAYMENT_MINUTES=2880
SAGA_TIMEOUT_EXECUTION_MINUTES=10

# ── REST síncrono (consultas consolidadas) ────────────────────────────────────
BILLING_SERVICE_URL=http://localhost:4100
EXECUTION_SERVICE_URL=http://localhost:4200
INTERNAL_HTTP_TIMEOUT_MS=2000

# ── Observabilidade (New Relic) ───────────────────────────────────────────────
# Deixe NEW_RELIC_LICENSE_KEY em branco para desabilitar o agente localmente
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=oficina-os-service
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_API_KEY=

LOG_LEVEL=info
